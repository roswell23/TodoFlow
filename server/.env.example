# ─── Database (Neon PostgreSQL) ─────────────────────────────────
# Pooled connection string — used by the Express server runtime
DATABASE_URL="postgresql://<user>:<password>@<ep-id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string — used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<ep-id>.<region>.aws.neon.tech/neondb?sslmode=require"

# ─── Server Configuration ───────────────────────────────────────
PORT=4000
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"

# ─── CORS Whitelist (Optional) ──────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ─── Initial Admin Account Seeding (Optional) ───────────────────
ADMIN_EMAIL="admin@todoflow.local"
ADMIN_PASSWORD="ChangeThisAdminPassword123!"
ADMIN_NAME="System Administrator"
